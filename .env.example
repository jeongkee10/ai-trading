# =============================================
# AI Trading System - 환경변수 설정
# =============================================
# 이 파일을 .env로 복사하고 실제 값을 입력하세요
# cp .env.example .env

# PostgreSQL 설정 (로컬 기본값)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_trading
DB_USER=postgres
DB_PASSWORD=your_password_here

# DART Open API (https://opendart.fss.or.kr 에서 무료 발급)
DART_API_KEY=your_dart_api_key_here

# 한국은행 ECOS API (https://ecos.bok.or.kr 에서 무료 발급)
ECOS_API_KEY=your_ecos_api_key_here

# 앱 설정
APP_PORT=8501
LOG_LEVEL=INFO

# 배치 설정 (매일 아침 배치 실행 시간, 24h 형식)
BATCH_HOUR=7
BATCH_MINUTE=0
